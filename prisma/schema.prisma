generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Appointment {
  id              Int      @id @default(autoincrement())
  code            String
  patientName     String
  phone           String
  service         String
  doctor          String
  appointmentDate String
  timeSlot        String
  paymentMethod   String
  status          String   @default("Chờ khám")
  createdAt       DateTime @default(now())
}

model User {
  id       Int    @id @default(autoincrement())
  username String @unique
  password String
  role     String @default("STAFF")
}
